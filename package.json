    "dependencies": {
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "proclubs-sdk": "^0.3.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/express": "^5.0.6",
        "@types/react": "^19.3.0",
